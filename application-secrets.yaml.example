# Copier ce fichier en application-secrets.yaml (à la racine du projet) et
# renseigner les vraies valeurs. Ce fichier n'est jamais commité (voir .gitignore).

DB_URL: "jdbc:postgresql://<host>.neon.tech/banque1_api_db?sslmode=require&channel_binding=require"
DB_USERNAME: <user>
DB_PASSWORD: <password>

# Doit avoir EXACTEMENT la même valeur que dans auth_api/application-secrets.yaml
JWT_SECRET: change_moi_avec_un_secret_long_et_aleatoire
INTERNAL_API_KEY: change_moi_avec_un_secret_long_et_aleatoire

AUTH_API_URL: http://localhost:8081
